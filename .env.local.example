# Supabase — copy to .env.local and fill in from your Supabase project settings.
# Project Settings -> API

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER expose to the browser. Used only in Route Handlers that
# must bypass RLS. In the MVP this is optional (all writes work under RLS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Edy assistant microservice — server-only, base URL only (no auth: Edy
# assumes an internal/trusted network). Consumed exclusively by
# app/api/edy/chat/route.ts; the browser never talks to Edy directly.
# Edy in turn calls back into this app's GET /api/courses/search, so that
# route must be reachable from wherever Edy runs.
EDY_SERVICE_URL=http://localhost:8000
